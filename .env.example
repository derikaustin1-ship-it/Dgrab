# Dgrab Transactional Email Notification Configuration
# Copy this file to .env.local for local development, or add variables to Vercel Project Settings > Environment Variables

# Resend Transactional Email API Key (Obtain free API key from https://resend.com)
RESEND_API_KEY=re_123456789_example_key

# Destination Email Address for all Free Sample Requests & Enquiries
NOTIFICATION_RECIPIENT_EMAIL=theywantweb@gmail.com

# Sender Address (Default Resend testing address or your verified custom domain address)
SENDER_EMAIL=Dgrab Enquiries <onboarding@resend.dev>
